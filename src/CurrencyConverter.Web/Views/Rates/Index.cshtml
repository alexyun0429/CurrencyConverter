@model RatesViewModel
@{
    ViewData["Title"] = "Rates";
}

<h1 class="mb-3">What 1 @Model.BaseCode buys</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="baseCode" class="form-label">Base currency</label>
        <select id="baseCode" name="baseCode" class="form-select" onchange="this.form.submit()">
            @foreach (var c in Model.Currencies)
            {
                <option value="@c.Code" selected="@(c.Code == Model.BaseCode)">@c.Code - @c.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Show</button>
    </div>
</form>

<p class="text-muted">Source: @Model.Source. Published @Model.RateDate?.ToString("d MMM yyyy").</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Currency</th>
            <th class="text-end">1 @Model.BaseCode =</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td><strong>@row.Code</strong></td>
                <td>@row.Name</td>
                <td class="text-end">@row.Rate.ToString("N4")</td>
            </tr>
        }
    </tbody>
</table>
